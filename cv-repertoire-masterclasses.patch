+        align-items: end;
+        gap: 4rem;
+        margin-bottom: 5rem;
+    }
+}
+
+/* ---------- masterclass ---------- */
+/* Mobile-first: titolo sopra, testo sotto, card in colonna. Da 576px due colonne; da 992px quattro colonne e titolo e testo sulla stessa riga */
+.masterclasses {
+    padding: 4rem var(--page-gutter) 5rem;
+    font-family: var(--font-brand);
+    color: var(--brand-bg);
+    background-color: var(--brand-dark);
+}
+
+.masterclasses-header {
+    display: grid;
+    gap: 1.5rem;
+    margin-bottom: 3rem;
+}
+
+.masterclasses-eyebrow {
+    margin: 0;
+    font-size: 0.75rem;
+    font-weight: 500;
+    letter-spacing: 0.2em;
+    text-transform: uppercase;
+    color: color-mix(in srgb, var(--brand-bg) 55%, transparent);
+}
+
+.masterclasses-title {
+    margin: 1.5rem 0 0;
+    font-family: var(--font-logo);
+    font-size: clamp(3rem, 12vw, 5.5rem);
+    font-weight: 300;
+    line-height: 0.95;
+    letter-spacing: -0.03em;
+}
+
+/* la seconda parte del titolo va sempre a capo */
+.masterclasses-title em {
+    display: block;
+    color: var(--brand-red);
+}
+
+.masterclasses-text {
+    max-width: 24rem;
+    margin: 0;
+    padding-left: 1.5rem;
+    font-size: 0.875rem;
+    line-height: 1.9;
+    color: color-mix(in srgb, var(--brand-bg) 60%, transparent);
+    border-left: 1px solid color-mix(in srgb, var(--brand-bg) 25%, transparent);
+}
+
+/* le linee tra le card sono lo sfondo che si vede dagli spazi di 1px: tiene il conto giusto con 4, 8, 12, 16... artisti */
+.masterclasses-grid {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr);
+    gap: 1px;
+    background-color: color-mix(in srgb, var(--brand-bg) 12%, transparent);
+    border: 1px solid color-mix(in srgb, var(--brand-bg) 12%, transparent);
+}
+
+@media (min-width: 576px) {
+    .masterclasses-grid {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+    }
+}
+
